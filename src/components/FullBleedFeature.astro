---
import Picture from "./Picture.astro";

interface Props {
  label: string;
  title: string;
  body1?: string;
  body2?: string;
  image: string;
  imageAlt: string;
  imagePosition?: string;
  reverse?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tall?: boolean;
}

const {
  label,
  title,
  body1,
  body2,
  image,
  imageAlt,
  imagePosition = "center",
  reverse = false,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  tall = false,
} = Astro.props;

const target = (href?: string) => href && (href.startsWith("http") || href.startsWith("mailto") || href.startsWith("tel")) ? "_blank" : undefined;
const rel = (href?: string) => target(href) ? "noopener noreferrer" : undefined;
---

<section class:list={["relative overflow-hidden flex items-center", tall ? "min-h-[90vh]" : "min-h-[78vh]"]}>
  <div class="absolute inset-0">
    <Picture
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover"
      style={`object-position: ${imagePosition};`}
      width="1600" height="1200"
      loading="lazy"
    />
    <div class:list={[
      "absolute inset-0",
      reverse ? "bg-gradient-to-l from-black/85 via-black/45 to-transparent" : "bg-gradient-to-r from-black/85 via-black/45 to-transparent"
    ]}></div>
  </div>

  <div
    class:list={["relative z-10 w-full flex", reverse ? "justify-end" : "justify-start"]}
    style="padding-left: clamp(1.5rem, 8vw, 8rem); padding-right: clamp(1.5rem, 8vw, 8rem);"
  >
    <div class:list={["max-w-lg py-16", reverse ? "text-right" : "text-left"]}>
      <span class="eyebrow-light mb-1">{label}</span>
      <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2.25rem,4.5vw,3.75rem)] text-white leading-tight mb-4">
        {title}
      </h2>
      <div class:list={["rule-light", reverse ? "ml-auto" : ""]}></div>
      {body1 && <p class="font-[family-name:var(--font-body)] text-white/70 leading-relaxed mb-4">{body1}</p>}
      {body2 && <p class="font-[family-name:var(--font-body)] text-white/70 leading-relaxed">{body2}</p>}
      {(ctaLabel || secondaryLabel) && (
        <div class:list={["flex flex-wrap gap-4 mt-8", reverse ? "justify-end" : "justify-start"]}>
          {ctaLabel && ctaHref && <a href={ctaHref} target={target(ctaHref)} rel={rel(ctaHref)} class="btn-primary">{ctaLabel}</a>}
          {secondaryLabel && secondaryHref && <a href={secondaryHref} target={target(secondaryHref)} rel={rel(secondaryHref)} class="btn-ghost">{secondaryLabel}</a>}
        </div>
      )}
    </div>
  </div>
</section>
