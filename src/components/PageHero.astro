---
import Picture from "./Picture.astro";

interface Props {
  label?: string;
  title: string;
  titleSuffix?: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  tall?: boolean;
  longTitle?: boolean;
}
const { label, title, titleSuffix, subtitle, image, imageAlt = "", imagePosition = "object-center", tall = false, longTitle = false } = Astro.props;
---

<section class:list={[
  "relative overflow-hidden flex items-center justify-center",
  longTitle ? "min-h-[55vh]" : (tall ? "min-h-[90vh]" : "min-h-[70vh]")
]}>
  {image && (
    <div class="absolute inset-0">
      <Picture
        src={image}
        alt={imageAlt}
        class={`w-full h-full object-cover ${imagePosition}`}
        width="1800" height="900"
        fetchpriority="high"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/25 to-black/70"></div>
    </div>
  )}
  {!image && (
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-teal)]/6 to-transparent"></div>
  )}

  <div class:list={["relative z-10 w-full mx-auto px-6 text-center", longTitle ? "max-w-3xl" : "max-w-4xl"]}>
    {label && <span class="eyebrow-light tracking-[0.25em] mx-auto block mb-4">{label}</span>}
    <h1 class:list={[
      "font-[family-name:var(--font-display)] italic leading-[1.05] mb-6",
      longTitle ? "text-[clamp(2rem,4.2vw,3.25rem)]" : (tall ? "text-[clamp(4.5rem,11vw,8.5rem)]" : "text-[clamp(4rem,10vw,7.5rem)]"),
      image ? "text-white" : "text-[var(--color-dark)]"
    ]}>
      {title}
      {titleSuffix && (
        <span class:list={[
          "block font-[family-name:var(--font-stamp)] not-italic text-[clamp(0.85rem,1.8vw,1.15rem)] tracking-[0.08em] mt-5 md:mt-6",
          image ? "text-white/75" : "text-[var(--color-dark)]/55"
        ]}>
          {titleSuffix}
        </span>
      )}
    </h1>
    {subtitle && (
      <p class:list={[
        "font-[family-name:var(--font-body)] text-lg max-w-xl mx-auto leading-relaxed",
        image ? "text-white/80" : "text-[var(--color-dark)]/60"
      ]}>
        {subtitle}
      </p>
    )}
    <slot />
  </div>
</section>
