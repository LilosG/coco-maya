---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import InfoCard from "./InfoCard.astro";
import ContainedFeature from "./ContainedFeature.astro";
import ContentCard from "./ContentCard.astro";
import FAQSection from "./FAQSection.astro";
import CTASection from "./CTASection.astro";
import MenuShowcase from "./MenuShowcase.astro";
import { breadcrumbSchema, faqPageSchema, menuSchema } from "../lib/schema";

interface Props {
  page: any;
  site: any;
  menuItems?: any[];
}

const { page, site, menuItems = [] } = Astro.props;
const schema: any[] = [
  breadcrumbSchema([
    { name: site.breadcrumbs.home, url: site.url },
    { name: page.breadcrumbLabel, url: `${site.url}${page.url}` },
  ]),
  faqPageSchema(page.faqs ?? []),
];

if (page.menuSection && menuItems.length) {
  schema.push(menuSchema([
    {
      name: page.menuSection.title,
      items: menuItems.map((item: any) => ({
        name: item.name,
        description: item.description,
        image: item.image,
      })),
    },
  ], site.url));
}
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
  extraSchema={schema}
>
  <Nav />

  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    longTitle
  >
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 justify-center">
      <a href={page.hero.primaryHref} class="btn-primary">{page.hero.primaryLabel}</a>
      <a href={page.hero.secondaryHref} class="btn-ghost">{page.hero.secondaryLabel}</a>
    </div>
  </PageHero>

  <section class="py-16 px-6 bg-[var(--color-cream)]">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5">
      {(page.infoCards ?? []).map((card: any) => (
        <InfoCard label={card.label} value={card.value} sub={card.sub} accent={card.accent} />
      ))}
    </div>
  </section>

  <ContainedFeature
    label={page.intro.label}
    title={page.intro.title}
    body1={page.intro.body1}
    body2={page.intro.body2}
    image={page.intro.image}
    imageAlt={page.intro.imageAlt}
    ctaLabel={page.intro.ctaLabel}
    ctaHref={page.intro.ctaHref}
    secondaryLabel={page.intro.secondaryLabel}
    secondaryHref={page.intro.secondaryHref}
  />

  {page.menuSection && menuItems.length > 0 && (
    <MenuShowcase
      eyebrow={page.menuSection.eyebrow}
      title={page.menuSection.title}
      subtitle={page.menuSection.subtitle}
      items={menuItems}
      ctaLabel={page.menuSection.ctaLabel}
      ctaHref={page.menuSection.ctaHref}
    />
  )}

  <section class="py-24 px-6 bg-[var(--color-sand-dark)]/25">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="eyebrow">{page.useCases.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">
          {page.useCases.title}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {(page.useCases.items ?? []).map((item: any) => (
          <ContentCard label={item.label} body={item.body} />
        ))}
      </div>
    </div>
  </section>

  <ContainedFeature
    label={page.feature.label}
    title={page.feature.title}
    body1={page.feature.body1}
    body2={page.feature.body2}
    image={page.feature.image}
    imageAlt={page.feature.imageAlt}
    ctaLabel={page.feature.ctaLabel}
    ctaHref={page.feature.ctaHref}
    secondaryLabel={page.feature.secondaryLabel}
    secondaryHref={page.feature.secondaryHref}
    reverse
    dark
  />

  <section class="py-20 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="eyebrow">{page.related.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">
          {page.related.title}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {(page.related.items ?? []).map((item: any) => (
          <a href={item.href} class="cc-card group block">
            <div class="cc-card__bar"></div>
            <div class="cc-card__body">
              <span class="cc-card__label">{item.label}</span>
              <p class="cc-card__text">{item.body}</p>
              <span class="font-[family-name:var(--font-body)] text-[var(--color-teal)] text-sm mt-5 inline-block group-hover:underline">
                Learn More
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={page.faqs} label="Good to Know" title={`${page.breadcrumbLabel} FAQ`} />

  <CTASection
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={page.cta.primaryHref}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref={page.cta.secondaryHref}
    dark={true}
  />

  <Footer />
</BaseLayout>
