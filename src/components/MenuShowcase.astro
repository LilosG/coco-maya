---
import MediaCardGrid from "./MediaCardGrid.astro";

interface ShowcaseItem {
  name: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  items: ShowcaseItem[];
  ctaLabel?: string;
  ctaHref?: string;
  ctaExternal?: boolean;
  dark?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  items = [],
  ctaLabel,
  ctaHref,
  ctaExternal = false,
  dark = false,
} = Astro.props;
---

<section class={`ms-section ${dark ? "ms-section--dark" : ""}`} aria-labelledby="ms-title">
  <div class="ms-head">
    <span class={dark ? "eyebrow-light" : "eyebrow"}>{eyebrow}</span>
    <h2 id="ms-title" class="ms-title">{title}</h2>
    {subtitle && <p class="ms-subtitle">{subtitle}</p>}
  </div>

  <div class="ms-grid-wrap">
    <MediaCardGrid items={items} aspect="portrait" />
  </div>

  {ctaLabel && ctaHref && (
    <div class="ms-cta">
      <a href={ctaHref} class="btn-outline" target={ctaExternal ? "_blank" : undefined} rel={ctaExternal ? "noopener noreferrer" : undefined}>{ctaLabel}</a>
    </div>
  )}
</section>

<style>
  .ms-section {
    padding: 96px 80px;
    background: var(--color-cream);
  }
  .ms-section--dark {
    background: var(--color-dark);
  }

  .ms-head { text-align: center; margin-bottom: 48px; }
  .ms-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    line-height: 1.05;
    margin: 0.5rem auto 0;
    color: var(--color-dark);
  }
  .ms-section--dark .ms-title { color: white; }
  .ms-subtitle {
    max-width: 560px; margin: 1rem auto 0;
    color: rgba(23,20,16,0.55); font-size: 0.9375rem; line-height: 1.55;
    font-family: var(--font-body);
  }
  .ms-section--dark .ms-subtitle { color: rgba(255,255,255,0.6); }

  .ms-grid-wrap {
    max-width: 1280px;
    margin: 0 auto;
  }

  .ms-cta { display: flex; justify-content: center; margin-top: 48px; }

  @media (max-width: 960px) {
    .ms-section { padding: 80px 40px; }
  }
  @media (max-width: 560px) {
    .ms-section { padding: 64px 20px; }
    .ms-head { margin-bottom: 36px; }
  }
</style>
