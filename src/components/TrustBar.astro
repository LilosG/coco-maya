---
import { getTodayHours } from "../lib/content";

interface TrustBarSite {
  trustBar: {
    hoursLabel: string;
    closed: string;
    rooftopLabel: string;
    rooftopSub: string;
    brunchLabel: string;
    brunchSub: string;
    locationLabel: string;
    locationSubTemplate: string;
  };
  hours: Array<{ day: string; open: boolean; hours: string }>;
  weekdaysSundayFirst: string[];
  serviceMessaging: { openDaily: string };
  service: { brunch: { shortTagline: string } };
  address: { neighborhood: string; street: string; mapsUrl: string };
}

interface Props {
  site: TrustBarSite;
}
const { site } = Astro.props;

const fill = (value: string, replacements: Record<string, string>) =>
  Object.entries(replacements).reduce((text, [key, replacement]) => text.replaceAll(`{{${key}}}`, replacement), value);

const todayHours = getTodayHours(site, site.trustBar.closed);

const items = [
  { label: site.trustBar.hoursLabel, value: todayHours, sub: null, href: null },
  { label: site.trustBar.rooftopLabel, value: site.serviceMessaging.openDaily, sub: site.trustBar.rooftopSub, href: "/happy-hour" },
  { label: site.trustBar.brunchLabel, value: site.service.brunch.shortTagline, sub: site.trustBar.brunchSub, href: "/brunch" },
  { label: site.trustBar.locationLabel, value: `${site.address.neighborhood}, SD`, sub: fill(site.trustBar.locationSubTemplate, { street: site.address.street }), href: site.address.mapsUrl },
];
---

<section class="bg-[var(--color-teal)]" aria-label="Restaurant hours and info">
  <dl class="max-w-7xl mx-auto px-6 lg:px-10 grid grid-cols-2 sm:grid-cols-4 divide-x divide-white/20">
    {items.map((item) => (
      <div class="flex flex-col items-center justify-center py-6 px-4 text-center">
        <dt class="eyebrow-light mb-2 text-white/55">{item.label}</dt>
        <dd>
          {item.href ? (
            <a
              href={item.href}
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="font-[family-name:var(--font-display)] italic text-white text-xl hover:text-white/80 transition-colors leading-tight"
            >
              {item.value}
            </a>
          ) : (
            <p class="font-[family-name:var(--font-display)] italic text-white text-xl leading-tight">{item.value}</p>
          )}
          {item.sub && <p class="text-white/50 text-xs font-[family-name:var(--font-body)] mt-1">{item.sub}</p>}
        </dd>
      </div>
    ))}
  </dl>
</section>
