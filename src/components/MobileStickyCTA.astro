---
import { getSingleton } from "../lib/content";

const SITE = await getSingleton("siteSettings");
---

<div
  class="fixed bottom-0 left-0 right-0 z-40 grid grid-cols-2 md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0);"
>
  <a
    href={SITE.reservations.url}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-2 py-4 bg-[var(--color-teal)] text-white font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    Reserve
  </a>
  <a
    href={`tel:${SITE.phone.tel}`}
    class="flex items-center justify-center gap-2 py-4 bg-[var(--color-dark)] text-white font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    Call Us
  </a>
</div>
