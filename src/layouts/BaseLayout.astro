---
import "../styles/global.css";
import { getSingleton } from "../lib/content";
import Analytics from "../components/Analytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import MobileStickyCTA from "../components/MobileStickyCTA.astro";

import ratingData from "../data/google-rating.json";

const SITE = await getSingleton("siteSettings");

const aggregateRating = (ratingData.rating && ratingData.count > 0)
  ? { "@type": "AggregateRating", ratingValue: ratingData.rating, bestRating: 5, worstRating: 1, reviewCount: ratingData.count }
  : null;

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string;
  extraSchema?: Record<string, unknown>[];
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = SITE.description,
  image = "/images/venue-hero-bar.jpg",
  noindex = false,
  keywords,
  extraSchema = [],
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);

// Group consecutive days that share identical hours into single
// OpeningHoursSpecification entries — the standard schema.org pattern,
// rather than one entry per day.
const calendarDays = Array.isArray(SITE.weekdaysSundayFirst) ? SITE.weekdaysSundayFirst : [];
const orderedDays = calendarDays.length ? [...calendarDays.slice(1), calendarDays[0]] : [];
const hoursByDay = new Map<string, string>((SITE.hours ?? []).map((h: any): [string, string] => [h.day, h.hours]));

function parseHoursRange(hours: string) {
  const [open, close] = hours.split("–").map((s) => s.trim());
  const to24 = (t: string) => {
    const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
    if (!m) return t;
    let [, hh, mm, ap] = m;
    let hour = parseInt(hh, 10) % 12;
    if (/PM/i.test(ap)) hour += 12;
    if (hour === 24) hour = 0;
    return `${String(hour).padStart(2, "0")}:${mm}`;
  };
  return { opens: to24(open), closes: to24(close === "12:00 AM" ? "11:59 PM" : close) };
}

const openingHoursSpecification: Record<string, unknown>[] = [];
let i = 0;
while (i < orderedDays.length) {
  const day = orderedDays[i];
  const hours = hoursByDay.get(day);
  if (!hours?.trim()) {
    i++;
    continue;
  }
  const group = [day];
  let j = i + 1;
  while (j < orderedDays.length && hoursByDay.get(orderedDays[j]) === hours) {
    group.push(orderedDays[j]);
    j++;
  }
  const { opens, closes } = parseHoursRange(hours);
  openingHoursSpecification.push({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: group.map((d) => `https://schema.org/${d}`),
    opens,
    closes,
  });
  i = j;
}

const schema = {
  "@context": "https://schema.org",
  "@type": SITE.schema.type,
  "@id": `${SITE.url}/#restaurant`,
  name: SITE.fullName,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone.tel,
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.state,
    postalCode: SITE.address.zip,
    addressCountry: SITE.schema.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.schema.geo.lat,
    longitude: SITE.schema.geo.lng,
  },
  priceRange: SITE.schema.priceRange,
  servesCuisine: SITE.schema.servesCuisine,
  hasMap: SITE.address.mapsUrl,
  sameAs: Object.values(SITE.social ?? {}),
  openingHoursSpecification,
  acceptsReservations: true,
  areaServed: [
    { "@type": "Place", name: SITE.address.neighborhood },
    { "@type": "City", name: SITE.address.city },
  ],
  ...(aggregateRating && { aggregateRating }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}${image}`} />
    <meta property="og:site_name" content={SITE.fullName} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}${image}`} />

    <link rel="icon" type="image/png" href="/images/logo-teal.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    {extraSchema.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}
    <Analytics />
  </head>
  <body class="pb-[60px] md:pb-0">
    <slot />
    <ConsentBanner siteName="Coco Maya" />
    <MobileStickyCTA />
  </body>
</html>
