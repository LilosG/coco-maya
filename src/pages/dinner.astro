---
import Picture from "../components/Picture.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import CTASection from "../components/CTASection.astro";
import InfoCard from "../components/InfoCard.astro";
import HoursTable from "../components/HoursTable.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import ContentCard from "../components/ContentCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../lib/content";
import { breadcrumbSchema, faqPageSchema, menuSchema } from "../lib/schema";

const [SITE, rawPages, dinnerItems] = await Promise.all([
  getSingleton("siteSettings"),
  getSingleton("commercialLandingPages"),
  getOrderedCollection("menuDinner"),
]);
const page = resolveSiteTokens(rawPages, SITE).dinner;
const dayNames = SITE.weekdaysSundayFirst ?? [];
const todayName = dayNames[new Date().getDay()];
const items = dinnerItems.map((item: any) => ({
  name: item.name,
  description: item.description,
  image: item.image,
  imageAlt: item.imageAlt ?? `${item.name} at Coco Maya Little Italy San Diego`,
}));
const schema = [
  faqPageSchema(page.faqs),
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}${page.url}` },
  ]),
  menuSchema([{ name: page.menuSection.title, items }], SITE.url),
];
---
<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} extraSchema={schema}>
  <Nav />

  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    imageFocus={page.hero.imageFocus}
    imageFocusMobile={page.hero.imageFocusMobile}
    tall={true}
  >
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 justify-center">
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.hero.primaryLabel}</a>
      <a href="/menu" class="btn-ghost">{page.hero.secondaryLabel}</a>
    </div>
  </PageHero>

  <TrustBar site={SITE} />

  <section class="py-16 px-6 bg-[var(--color-cream)]">
    <div class="relative max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
      {page.infoCards.map((card: any) => <InfoCard label={card.label} value={card.value} sub={card.sub} accent={card.accent} />)}
      <div class="hidden sm:block absolute -z-10 -bottom-4 -right-4 w-full h-full border border-[var(--color-teal)]/20 pointer-events-none"></div>
    </div>
    <div class="max-w-4xl mx-auto">
      <HoursTable heading="Dinner Hours" days={SITE.service.dinner.days} todayName={todayName} />
    </div>
  </section>

  <div id="menu">
    <MenuShowcase
      eyebrow={page.menuSection.eyebrow}
      title={page.menuSection.title}
      subtitle={page.menuSection.subtitle}
      items={items}
      ctaLabel={page.menuSection.ctaLabel}
      ctaHref={SITE.fullMenu.url}
      ctaExternal={true}
    />
  </div>

  <div class="cm-divider"></div>

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="eyebrow">{page.intro.label}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2.25rem,4vw,3.5rem)] text-[var(--color-dark)] leading-tight mb-6">{page.intro.title}</h2>
        <div class="rule"></div>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/65 leading-relaxed mb-5 text-[1.0625rem]">{page.intro.body1}</p>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/65 leading-relaxed mb-10 text-[1.0625rem]">{page.intro.body2}</p>
        <div class="flex flex-wrap gap-4">
          <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">Reserve Dinner</a>
          <a href="/happy-hour" class="btn-outline">Happy Hour</a>
        </div>
      </div>
      <div class="relative">
        <Picture
          src={page.intro.image}
          alt={page.intro.imageAlt}
          class="w-full aspect-[4/5] object-cover object-center"
          width="700"
          height="875"
          loading="lazy"
        />
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-[var(--color-teal)]/20 -z-10 pointer-events-none"></div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-[var(--color-sand-dark)]/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="eyebrow">{page.useCases.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">{page.useCases.title}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {page.useCases.items.map((item: any) => <ContentCard label={item.label} body={item.body} />)}
      </div>
    </div>
  </section>

  <section class="relative min-h-[58vh] overflow-hidden flex items-center">
    <div class="absolute inset-0">
      <Picture
        src={page.feature.image}
        alt={page.feature.imageAlt}
        class="w-full h-full object-cover"
        style="object-position: center 45%;"
        width="1800"
        height="1000"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/10"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto w-full px-6 md:px-10 py-20">
      <div class="max-w-xl">
        <span class="eyebrow-light">{page.feature.label}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-white text-[clamp(2.25rem,4.5vw,3.75rem)] leading-tight mb-5">{page.feature.title}</h2>
        <div class="rule-light"></div>
        <p class="font-[family-name:var(--font-body)] text-white/75 leading-relaxed mb-4">{page.feature.body1}</p>
        <p class="font-[family-name:var(--font-body)] text-white/75 leading-relaxed mb-8">{page.feature.body2}</p>
        <div class="flex flex-wrap gap-4">
          <a href={page.feature.ctaHref} class="btn-primary">{page.feature.ctaLabel}</a>
          <a href={page.feature.secondaryHref} class="btn-ghost">{page.feature.secondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="eyebrow">{page.related.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">{page.related.title}</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {page.related.items.map((item: any) => (
          <a href={item.href} class="cc-card group block">
            <div class="cc-card__bar"></div>
            <div class="cc-card__body">
              <span class="cc-card__label">{item.label}</span>
              <p class="cc-card__text">{item.body}</p>
              <span class="text-[var(--color-teal)] text-sm mt-5 inline-block group-hover:underline">Learn More</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={page.faqs} label="Dinner in Little Italy" title="Dinner FAQ" />
  <CTASection
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref="/menu"
    dark={true}
  />
  <Footer />
</BaseLayout>
