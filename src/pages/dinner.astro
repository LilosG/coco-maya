---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import InfoCard from "../components/InfoCard.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import ContainedFeature from "../components/ContainedFeature.astro";
import FullBleedFeature from "../components/FullBleedFeature.astro";
import ContentCard from "../components/ContentCard.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../lib/content";
import { breadcrumbSchema, faqPageSchema, menuSchema } from "../lib/schema";

const [SITE, rawPages, dinnerItems] = await Promise.all([
  getSingleton("siteSettings"),
  getSingleton("commercialLandingPages"),
  getOrderedCollection("menuDinner"),
]);
const page = resolveSiteTokens(rawPages, SITE).dinner;
const items = dinnerItems.map((item: any) => ({
  name: item.name,
  description: item.description,
  image: item.image,
  imageAlt: item.imageAlt ?? `${item.name} at Coco Maya Little Italy San Diego`,
}));
const schema = [
  faqPageSchema(page.faqs),
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}${page.url}` },
  ]),
  menuSchema([{ name: page.menuSection.title, items }], SITE.url),
];
---
<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} extraSchema={schema}>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    tall={true}
  >
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 justify-center">
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.hero.primaryLabel}</a>
      <a href="/menu" class="btn-ghost">{page.hero.secondaryLabel}</a>
    </div>
  </PageHero>

  <TrustBar site={SITE} />

  <section class="py-16 px-6 bg-[var(--color-cream)]">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
      {page.infoCards.map((card: any) => <InfoCard label={card.label} value={card.value} sub={card.sub} accent={card.accent} />)}
    </div>
    <div class="max-w-4xl mx-auto bg-white border border-[var(--color-teal)]/12">
      <div class="px-6 pt-6 pb-2"><span class="eyebrow">Dinner Hours</span></div>
      <div class="divide-y divide-[var(--color-teal)]/10 px-6 pb-6">
        {SITE.service.dinner.days.map((d: any) => (
          <div class="flex justify-between py-3 font-[family-name:var(--font-body)] text-sm text-[var(--color-dark)]/60">
            <span>{d.day}</span><span>{d.hours}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <MenuShowcase
    eyebrow={page.menuSection.eyebrow}
    title={page.menuSection.title}
    subtitle={page.menuSection.subtitle}
    items={items}
    ctaLabel={page.menuSection.ctaLabel}
    ctaHref={SITE.fullMenu.url}
    ctaExternal={true}
  />

  <ContainedFeature
    label={page.intro.label}
    title={page.intro.title}
    body1={page.intro.body1}
    body2={page.intro.body2}
    image={page.intro.image}
    imageAlt={page.intro.imageAlt}
    ctaLabel="Reserve Dinner"
    ctaHref={SITE.reservations.url}
    secondaryLabel="Happy Hour"
    secondaryHref="/happy-hour"
  />

  <FullBleedFeature
    label={page.feature.label}
    title={page.feature.title}
    body1={page.feature.body1}
    body2={page.feature.body2}
    image={page.feature.image}
    imageAlt={page.feature.imageAlt}
    ctaLabel={page.feature.ctaLabel}
    ctaHref={page.feature.ctaHref}
    secondaryLabel={page.feature.secondaryLabel}
    secondaryHref={page.feature.secondaryHref}
  />

  <section class="py-24 px-6 bg-[var(--color-sand-dark)]/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="eyebrow">{page.useCases.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">{page.useCases.title}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {page.useCases.items.map((item: any) => <ContentCard label={item.label} body={item.body} />)}
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
      {page.related.items.map((item: any) => (
        <a href={item.href} class="cc-card group block">
          <div class="cc-card__bar"></div>
          <div class="cc-card__body">
            <span class="cc-card__label">{item.label}</span>
            <p class="cc-card__text">{item.body}</p>
            <span class="text-[var(--color-teal)] text-sm mt-5 inline-block group-hover:underline">Learn More</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <FAQSection faqs={page.faqs} label="Dinner in Little Italy" title="Dinner FAQ" />
  <CTASection
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref="/menu"
    dark={true}
  />
  <Footer />
</BaseLayout>
