---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import FullBleedFeature from "../../components/FullBleedFeature.astro";
import ContainedFeature from "../../components/ContainedFeature.astro";
import CTASection from "../../components/CTASection.astro";
import { getOrderedCollection, getSingleton } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";

const [SITE, page, spaces] = await Promise.all([getSingleton("siteSettings"), getSingleton("spacePage"), getOrderedCollection("theSpaceSections")]);
const fill = (value: string) => value.replaceAll("{{street}}", SITE.address.street);
const barDetail = spaces.find((space) => space?.barDetail)?.barDetail;
const schema = [
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}/the-space` },
  ]),
];
---
<BaseLayout
  title={page.seo.title}
  description={fill(page.seo.descriptionTemplate)}
  image={page.seo.image}
  extraSchema={schema}
>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    tall={true}
  />

  <section class="bg-[var(--color-teal)]">
    <div class="max-w-4xl mx-auto px-6 grid grid-cols-3 divide-x divide-white/20 text-center">
      {spaces.map((item) => (
        <div class="px-6 py-5">
          <span class="eyebrow-light mb-1">{item.summaryLabel}</span>
          <p class="font-[family-name:var(--font-display)] italic text-white text-lg">{item.summaryValue}</p>
        </div>
      ))}
    </div>
  </section>

  {spaces.map((space) => (
    space.layout === "contained" ? (
      <ContainedFeature
        label={space.label}
        title={space.title}
        body1={space.body1}
        body2={space.body2}
        image={space.image}
        imageAlt={space.imageAlt}
        reverse={space.reverse}
        dark={true}
      />
    ) : (
      <FullBleedFeature
        label={space.label}
        title={space.title}
        body1={space.body1}
        body2={space.body2}
        image={space.image}
        imageAlt={space.imageAlt}
        reverse={space.reverse}
      />
    )
  ))}


  <!-- THE BAR SECTION -->
  {barDetail && (
    <ContainedFeature
      label={barDetail.eyebrow}
      title={barDetail.title}
      body1={barDetail.body1}
      body2={barDetail.body2}
      image={barDetail.image}
      imageAlt={barDetail.imageAlt}
      dark={true}
      ctaLabel={page.barCtas.menuLabel}
      ctaHref="/menu"
      secondaryLabel={page.barCtas.patioLabel}
      secondaryHref="/happy-hour"
    />
  )}

  <CTASection
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref="/private-events"
    dark={true}
  />
  <Footer />
</BaseLayout>
