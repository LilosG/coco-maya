---
import Picture from "../../components/Picture.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import CTASection from "../../components/CTASection.astro";
import EventInquiryForm from "../../components/EventInquiryForm.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";
const [SITE, page, rawRecurringEvents] = await Promise.all([getSingleton("siteSettings"), getSingleton("eventsPage"), getOrderedCollection("recurringEvents")]);
const RECURRING_EVENTS = resolveSiteTokens(rawRecurringEvents, SITE);
const fill = (value: string) => value.replaceAll("{{street}}", SITE.address.street).replaceAll("{{openDaily}}", SITE.serviceMessaging.openDailyLower);
const schema = [
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}/events` },
  ]),
];
---
<BaseLayout
  title={page.seo.title}
  description={fill(page.seo.descriptionTemplate)}
  image={page.seo.image}
  extraSchema={schema}
>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    tall={true}
  />
  <TrustBar site={SITE} />

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto">
      <div class="mb-16">
        <span class="eyebrow">{page.recurring.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3.5rem)] text-[var(--color-dark)]">{page.recurring.title}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {RECURRING_EVENTS.map((event) => (
          <div class="cm-media-card group">
            <div class="relative aspect-video overflow-hidden">
              <Picture
                src={event.image}
                alt={`${event.name} at Coco Maya Little Italy San Diego`}
                class="w-full h-full object-cover"
                width="800" height="450"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <span class="bg-[var(--color-teal)] text-white font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-3 py-1.5">
                  {event.highlight}
                </span>
              </div>
            </div>
            <div class="p-7">
              <h3 class="font-[family-name:var(--font-display)] italic text-[var(--color-dark)] text-2xl mb-2">{event.name}</h3>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-4 h-px bg-[var(--color-teal)]"></div>
                <span class="eyebrow mb-0">{event.day} &bull; {event.time}</span>
              </div>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/55 text-sm leading-relaxed">{event.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-dark)] px-6 py-0">
    <div class="max-w-4xl mx-auto cm-dark-grid" style="grid-template-columns: 1fr 1fr;">
      <div class="cm-dark-grid-cell py-14 text-left">
        <span class="eyebrow-light mb-4">{page.promos.privateEvents.eyebrow}</span>
        <h3 class="font-[family-name:var(--font-display)] italic text-white text-3xl mb-4">{page.promos.privateEvents.title}</h3>
        <p class="font-[family-name:var(--font-body)] text-white/50 leading-relaxed mb-8 text-sm">
          {page.promos.privateEvents.body}
        </p>
        <a href="/private-events" class="btn-primary">{page.promos.privateEvents.label}</a>
      </div>
      <div class="cm-dark-grid-cell py-14 text-left">
        <span class="eyebrow-light mb-4">{page.promos.reservations.eyebrow}</span>
        <h3 class="font-[family-name:var(--font-display)] italic text-white text-3xl mb-4">{page.promos.reservations.title}</h3>
        <p class="font-[family-name:var(--font-body)] text-white/50 leading-relaxed mb-8 text-sm">
          {fill(page.promos.reservations.bodyTemplate)}
        </p>
        <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.promos.reservations.label}</a>
      </div>
    </div>
  </section>

  <EventInquiryForm
    label={page.form.label}
    subtitle={page.form.subtitle}
    formUrl={SITE.inquiryForm.url}
    ctaLabel={page.form.ctaLabel}
  />

  <CTASection
    title={page.cta.title}
    subtitle={fill(page.cta.subtitleTemplate)}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref="/private-events"
  />
  <Footer />
</BaseLayout>
