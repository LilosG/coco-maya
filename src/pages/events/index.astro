---
import Picture from "../../components/Picture.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import ContainedFeature from "../../components/ContainedFeature.astro";
import CTASection from "../../components/CTASection.astro";
import EventInquiryForm from "../../components/EventInquiryForm.astro";
import FAQSection from "../../components/FAQSection.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../../lib/content";
import { breadcrumbSchema, recurringEventSchema, faqPageSchema } from "../../lib/schema";
const [SITE, page, rawRecurringEvents, rawEventsFaqs] = await Promise.all([getSingleton("siteSettings"), getSingleton("eventsPage"), getOrderedCollection("recurringEvents"), getOrderedCollection("eventsFaqs")]);
const RECURRING_EVENTS = resolveSiteTokens(rawRecurringEvents, SITE);
const EVENTS_FAQS = rawEventsFaqs as { question: string; answer: string }[];
const fill = (value: string) => value.replaceAll("{{street}}", SITE.address.street).replaceAll("{{openDaily}}", SITE.serviceMessaging.openDailyLower);
const eventAddress = {
  streetAddress: SITE.address.street,
  addressLocality: SITE.address.city,
  addressRegion: SITE.address.state,
  postalCode: SITE.address.zip,
  addressCountry: "US",
};
const schema = [
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}/events` },
  ]),
  faqPageSchema(EVENTS_FAQS),
  recurringEventSchema({
    name: "Daily Brunch at Coco Maya",
    description: "Daily brunch on the elevated rooftop patio in Little Italy, San Diego, served every day until 3:00 PM.",
    url: `${SITE.url}/brunch`,
    schedules: [
      { daysOfWeek: ["Sunday", "Friday", "Saturday"], startTime: "09:00", endTime: "15:00" },
      { daysOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], startTime: "10:30", endTime: "15:00" },
    ],
    placeName: SITE.fullName,
    address: eventAddress,
  }),
  recurringEventSchema({
    name: "Happy Hour at Coco Maya",
    description: "Weekday happy hour on the elevated rooftop patio in Little Italy, San Diego: craft cocktails and shareable bites, Monday through Friday, 4:00-6:00 PM.",
    url: `${SITE.url}/happy-hour`,
    schedules: [
      { daysOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], startTime: "16:00", endTime: "18:00" },
    ],
    placeName: SITE.fullName,
    address: eventAddress,
  }),
  recurringEventSchema({
    name: "Dinner at Coco Maya",
    description: "Modern American coastal dinner service every night of the week in Little Italy, San Diego, on the elevated patio or in the glass atrium dining room.",
    url: `${SITE.url}/dinner`,
    schedules: [
      { daysOfWeek: ["Sunday", "Monday", "Tuesday", "Wednesday"], startTime: "17:00", endTime: "20:00" },
      { daysOfWeek: ["Thursday"], startTime: "17:00", endTime: "21:00" },
      { daysOfWeek: ["Friday", "Saturday"], startTime: "17:00", endTime: "22:30" },
    ],
    placeName: SITE.fullName,
    address: eventAddress,
  }),
];
---
<BaseLayout
  title={page.seo.title}
  description={fill(page.seo.descriptionTemplate)}
  image={page.seo.image}
  extraSchema={schema}
>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    tall={true}
  />
  <TrustBar site={SITE} />

  <ContainedFeature
    label={page.intro.eyebrow}
    title={page.intro.title}
    body1={fill(page.intro.body1)}
    body2={page.intro.body2}
    image={page.intro.image}
    imageAlt={page.intro.imageAlt}
    aspect="4/5"
    bg="sand"
    reverse={true}
    ctaLabel={page.intro.ctaLabel}
    ctaHref={page.intro.ctaHref}
  />

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto">
      <div class="mb-16 max-w-2xl">
        <span class="eyebrow">{page.recurring.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3.5rem)] text-[var(--color-dark)] mb-6">{page.recurring.title}</h2>
        <div class="rule"></div>
        {page.recurring.subtitle && (
          <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/60 leading-relaxed">{page.recurring.subtitle}</p>
        )}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {RECURRING_EVENTS.map((event) => (
          <a href={event.href} class="cm-media-card group block">
            <div class="relative aspect-video overflow-hidden">
              <Picture
                src={event.image}
                alt={`${event.name} at Coco Maya Little Italy San Diego`}
                class="w-full h-full object-cover"
                width="800" height="450"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <span class="bg-[var(--color-teal)] text-white font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-3 py-1.5">
                  {event.highlight}
                </span>
              </div>
            </div>
            <div class="p-7">
              <h3 class="font-[family-name:var(--font-display)] italic text-[var(--color-dark)] text-2xl mb-2 group-hover:text-[var(--color-teal)] transition-colors">{event.name}</h3>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-4 h-px bg-[var(--color-teal)]"></div>
                <span class="eyebrow mb-0">{event.day} &bull; {event.time}</span>
              </div>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/55 text-sm leading-relaxed">{event.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-dark)] px-6 py-0">
    <div class="max-w-4xl mx-auto cm-dark-grid" style="grid-template-columns: 1fr 1fr;">
      <div class="cm-dark-grid-cell py-14 text-left">
        <span class="eyebrow-light mb-4">{page.promos.privateEvents.eyebrow}</span>
        <h3 class="font-[family-name:var(--font-display)] italic text-white text-3xl mb-4">{page.promos.privateEvents.title}</h3>
        <div class="rule-light"></div>
        <p class="font-[family-name:var(--font-body)] text-white/50 leading-relaxed mb-8 text-sm">
          {page.promos.privateEvents.body}
        </p>
        <a href="/private-events" class="btn-primary">{page.promos.privateEvents.label}</a>
      </div>
      <div class="cm-dark-grid-cell py-14 text-left">
        <span class="eyebrow-light mb-4">{page.promos.reservations.eyebrow}</span>
        <h3 class="font-[family-name:var(--font-display)] italic text-white text-3xl mb-4">{page.promos.reservations.title}</h3>
        <div class="rule-light"></div>
        <p class="font-[family-name:var(--font-body)] text-white/50 leading-relaxed mb-8 text-sm">
          {fill(page.promos.reservations.bodyTemplate)}
        </p>
        <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.promos.reservations.label}</a>
      </div>
    </div>
  </section>

  <EventInquiryForm
    label={page.form.label}
    subtitle={page.form.subtitle}
    formUrl={SITE.inquiryForm.url}
    ctaLabel={page.form.ctaLabel}
  />

  <FAQSection
    faqs={EVENTS_FAQS}
    label={page.faq.label}
    title={page.faq.title}
    subtitle={page.faq.subtitle}
    bg="sand"
  />

  <CTASection
    title={page.cta.title}
    subtitle={fill(page.cta.subtitleTemplate)}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref="/private-events"
    dark={true}
  />
  <Footer />
</BaseLayout>
