---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import InfoCard from "../components/InfoCard.astro";
import ContentCard from "../components/ContentCard.astro";
import FullBleedFeature from "../components/FullBleedFeature.astro";
import ContainedFeature from "../components/ContainedFeature.astro";
import FindUs from "../components/FindUs.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";
import { getSingleton, resolveSiteTokens } from "../lib/content";
import { breadcrumbSchema, faqPageSchema } from "../lib/schema";

const [SITE, rawPages] = await Promise.all([getSingleton("siteSettings"), getSingleton("commercialLandingPages")]);
const page = resolveSiteTokens(rawPages, SITE).conventionDining;
const schema = [
  faqPageSchema(page.faqs),
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}${page.url}` },
  ]),
];
---
<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} extraSchema={schema}>
  <Nav />

  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    imageFocus={page.hero.imageFocus}
    imageFocusMobile={page.hero.imageFocusMobile}
    tall={true}
    longTitle={true}
  >
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 justify-center">
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">Reserve a Table</a>
      <a href="/private-events/corporate-events" class="btn-ghost">Corporate Events</a>
    </div>
  </PageHero>

  <TrustBar site={SITE} />

  <section class="py-16 px-6 bg-[var(--color-cream)]">
    <div class="relative max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5">
      {page.infoCards.map((card: any) => <InfoCard label={card.label} value={card.value} sub={card.sub} accent={card.accent} />)}
      <div class="hidden sm:block absolute -z-10 -bottom-5 -right-5 w-full h-full border border-[var(--color-teal)]/30 pointer-events-none"></div>
    </div>
  </section>

  <ContainedFeature
    label={page.intro.label}
    title={page.intro.title}
    body1={page.intro.body1}
    body2={page.intro.body2}
    image={page.intro.image}
    imageAlt={page.intro.imageAlt}
    aspect="4/5"
    imagePosition="center 45%"
    ctaLabel="See Dinner"
    ctaHref="/dinner"
    secondaryLabel="Happy Hour"
    secondaryHref="/happy-hour"
  />

  <section class="py-24 px-6 bg-[var(--color-sand-dark)]/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="eyebrow">{page.useCases.eyebrow}</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">{page.useCases.title}</h2>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/55 max-w-2xl mx-auto mt-4 leading-relaxed">Coco Maya works best when the meal has enough time to leave the immediate convention blocks and the setting matters as much as convenience.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {page.useCases.items.map((item: any) => <ContentCard label={item.label} body={item.body} />)}
      </div>
    </div>
  </section>

  <FullBleedFeature
    label={page.feature.label}
    title={page.feature.title}
    body1={page.feature.body1}
    body2={page.feature.body2}
    image={page.feature.image}
    imageAlt={page.feature.imageAlt}
    imagePosition="center 45%"
    ctaLabel={page.feature.ctaLabel}
    ctaHref={page.feature.ctaHref}
    secondaryLabel={page.feature.secondaryLabel}
    secondaryHref={page.feature.secondaryHref}
  />

  <ContainedFeature
    label={page.logistics.label}
    title={page.logistics.title}
    body1={page.logistics.body1}
    body2={page.logistics.body2}
    image={page.logistics.image}
    imageAlt={page.logistics.imageAlt}
    aspect="4/5"
    imagePosition="center 50%"
    reverse={true}
    ctaLabel="Reserve a Table"
    ctaHref={SITE.reservations.url}
    secondaryLabel="Convention Dining Guide"
    secondaryHref="/blog/restaurants-near-san-diego-convention-center-guide"
  />

  <FindUs interiorImage="/images/venue-interior-dining.jpg" />

  <FAQSection faqs={page.faqs} label="Convention Dining" title="San Diego Convention Dining FAQ" />
  <CTASection
    title={page.cta.title}
    subtitle={page.cta.subtitle}
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="Plan a Corporate Event"
    secondaryHref="/private-events/corporate-events"
    dark={true}
  />
  <Footer />
</BaseLayout>
