---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import ContainedFeature from "../components/ContainedFeature.astro";
import FullBleedFeature from "../components/FullBleedFeature.astro";
import ContentCard from "../components/ContentCard.astro";
import FAQSection from "../components/FAQSection.astro";
import CTASection from "../components/CTASection.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../lib/content";
import { breadcrumbSchema, faqPageSchema } from "../lib/schema";

const [SITE, rawPages, rawEventTypes] = await Promise.all([getSingleton("siteSettings"), getSingleton("commercialLandingPages"), getOrderedCollection("privateEventTypes")]);
const page = resolveSiteTokens(rawPages, SITE).businessDining;
const corporate = resolveSiteTokens(rawEventTypes, SITE).find((event: any) => event.slug === "corporate-events");
const schema = [
  breadcrumbSchema([{ name: SITE.breadcrumbs.home, url: SITE.url }, { name: page.breadcrumbLabel, url: `${SITE.url}${page.url}` }]),
  faqPageSchema(page.faqs),
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} extraSchema={schema}>
  <Nav />
  <PageHero label={page.hero.label} title={page.hero.title} titleSuffix={page.hero.titleSuffix} subtitle={page.hero.subtitle} image={page.hero.image} imageAlt={page.hero.imageAlt} tall={true}>
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 mt-8 justify-center">
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.hero.primaryLabel}</a>
      <a href={page.hero.secondaryHref} class="btn-ghost">{page.hero.secondaryLabel}</a>
    </div>
  </PageHero>

  <TrustBar site={SITE} />

  <ContainedFeature label={page.intro.label} title={page.intro.title} body1={page.intro.body1} body2={page.intro.body2} image={page.intro.image} imageAlt={page.intro.imageAlt} ctaLabel={page.intro.ctaLabel} ctaHref={page.intro.ctaHref} secondaryLabel={page.intro.secondaryLabel} secondaryHref={page.intro.secondaryHref} />

  <section class="py-24 px-6 bg-[var(--color-sand-dark)]/25">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="eyebrow">Built for Business Groups</span>
        <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-dark)]">The operational details matter as much as the table</h2>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/60 leading-relaxed mt-4 max-w-3xl mx-auto">Smaller client meals can stay simple. When a company group needs dedicated space, presentations, dietary planning, centralized billing, or daytime availability, Coco Maya's existing corporate-event program provides the additional structure.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">{(corporate?.highlights ?? []).map((item: any) => <ContentCard label={item.label} body={item.detail} />)}</div>
    </div>
  </section>

  <FullBleedFeature label={page.feature.label} title={page.feature.title} body1={page.feature.body1} body2={page.feature.body2} image={page.feature.image} imageAlt={page.feature.imageAlt} imagePosition="center" ctaLabel={page.feature.ctaLabel} ctaHref={page.feature.ctaHref} secondaryLabel={page.feature.secondaryLabel} secondaryHref={page.feature.secondaryHref} />

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14"><span class="eyebrow">{page.useCases.eyebrow}</span><h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3rem)] text-[var(--color-dark)]">{page.useCases.title}</h2></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">{page.useCases.items.map((item: any) => <ContentCard label={item.label} body={item.body} />)}</div>
    </div>
  </section>

  <FAQSection faqs={page.faqs} label="Business Dining" title="Business Dining FAQ" />
  <CTASection title={page.cta.title} subtitle={page.cta.subtitle} primaryLabel={page.cta.primaryLabel} primaryHref={SITE.reservations.url} secondaryLabel={page.cta.secondaryLabel} secondaryHref={page.cta.secondaryHref} dark={true} />
  <Footer />
</BaseLayout>
