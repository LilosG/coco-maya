---
import Picture from "../components/Picture.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import CTASection from "../components/CTASection.astro";
import ContentCard from "../components/ContentCard.astro";
import FAQSection from "../components/FAQSection.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../lib/content";
import { faqPageSchema, breadcrumbSchema } from "../lib/schema";

const [SITE, rawPage, rawFaqs] = await Promise.all([getSingleton("siteSettings"), getSingleton("happyHourPage"), getOrderedCollection("happyHourFaqs")]);
const page = resolveSiteTokens(rawPage, SITE);
const faqs = rawFaqs as { question: string; answer: string }[];
const fill = (value: string) => value.replaceAll("{{street}}", SITE.address.street);
const schema = [
  faqPageSchema(faqs),
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}/happy-hour` },
  ]),
];

const foodItems = (page.food ?? []).map((item: any) => ({
  name: item.name,
  description: item.description,
  image: item.image || undefined,
  imageAlt: item.imageAlt,
}));

const drinkItems = (page.drinks ?? []).map((item: any) => ({
  name: item.name,
  description: item.subtitle ? `${item.subtitle} · ${item.description}` : item.description,
  image: item.image || undefined,
  imageAlt: item.imageAlt,
}));
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
  keywords={page.seo.keywords}
  extraSchema={schema}
>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    imagePosition={page.hero.imagePosition ?? "object-center"}
    tall={true}
  />

  <TrustBar site={SITE} />

  <!-- Happy Hour Key Info: Days / Hours / Location -->
  <section class="hh-stats" aria-label="Happy hour hours and location">
    <div class="hh-stats__inner">
      <div class="hh-stats__item">
        <span class="hh-stats__label">Days</span>
        <p class="hh-stats__value">Mon–Fri</p>
      </div>
      <div class="hh-stats__divider" aria-hidden="true"></div>
      <div class="hh-stats__item">
        <span class="hh-stats__label">Hours</span>
        <p class="hh-stats__value hh-stats__value--accent">4–6 PM</p>
      </div>
      <div class="hh-stats__divider" aria-hidden="true"></div>
      <div class="hh-stats__item">
        <span class="hh-stats__label">Location</span>
        <p class="hh-stats__value hh-stats__value--sm">Little Italy</p>
        <p class="hh-stats__sub">1660 India St, San Diego CA</p>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="eyebrow">{page.intro.eyebrow}</span>
          <h2 class="font-[family-name:var(--font-display)] italic text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-dark)] mb-4 text-wrap-balance">
            {page.intro.title}
          </h2>
          <div class="rule"></div>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/65 leading-relaxed mb-4 text-[1.0625rem]">
            {page.intro.body1}
          </p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-dark)]/65 leading-relaxed mb-10 text-[1.0625rem]">
            {page.intro.body2}
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer" class="btn-primary">{page.intro.reserveLabel}</a>
            <a href="/menu" class="btn-outline">{page.intro.menuLabel}</a>
          </div>
        </div>
        <div class="relative">
          <Picture
            src={page.intro.image}
            alt={page.intro.imageAlt}
            class="w-full aspect-square object-cover"
            width="600" height="600"
            loading="lazy"
          />
          <div class="absolute -bottom-4 -right-4 w-full h-full border border-[var(--color-teal)]/20 -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <MenuShowcase
    eyebrow={page.foodSection.eyebrow}
    title={page.foodSection.title}
    items={foodItems}
  />

  <div class="cm-divider"></div>

  <MenuShowcase
    eyebrow={page.drinksSection.eyebrow}
    title={page.drinksSection.title}
    subtitle={page.drinksSection.subtitle}
    items={drinkItems}
    dark={true}
  />

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {(page.features ?? []).map((item: any) => (
          <ContentCard label={item.label} body={item.body} />
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} label={page.faq.label} title={page.faq.title} />

  <CTASection
    title={page.cta.title}
    subtitle={fill(page.cta.subtitleTemplate)}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref={SITE.address.mapsUrl}
    dark={true}
  />
  <Footer />
</BaseLayout>

<style>
  /* ── Happy Hour Stats Strip ───────────────────────────── */
  .hh-stats {
    background-color: var(--color-dark-mid);
    padding: 3.5rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.04);
  }

  .hh-stats__inner {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .hh-stats__item {
    flex: 1;
    text-align: center;
    padding: 0.5rem 2rem;
  }

  .hh-stats__divider {
    width: 1px;
    height: 3.5rem;
    background: rgba(255,255,255,0.1);
    flex-shrink: 0;
  }

  .hh-stats__label {
    font-family: var(--font-stamp);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(126,207,191,0.55);
    display: block;
    margin-bottom: 0.6rem;
  }

  .hh-stats__value {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1;
    color: #fff;
    margin: 0;
  }

  .hh-stats__value--accent {
    color: var(--color-teal-light);
  }

  .hh-stats__value--sm {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .hh-stats__sub {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.3);
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .hh-stats { padding: 2.5rem 1.25rem; }
    .hh-stats__inner { flex-direction: column; gap: 2rem; }
    .hh-stats__divider { width: 2.5rem; height: 1px; }
    .hh-stats__item { padding: 0; }
  }
</style>
