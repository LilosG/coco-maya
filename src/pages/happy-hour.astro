---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import CTASection from "../components/CTASection.astro";
import InfoCard from "../components/InfoCard.astro";
import ContentCard from "../components/ContentCard.astro";
import FAQSection from "../components/FAQSection.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import FullBleedFeature from "../components/FullBleedFeature.astro";
import ContainedFeature from "../components/ContainedFeature.astro";
import { getOrderedCollection, getSingleton, resolveSiteTokens } from "../lib/content";
import { faqPageSchema, breadcrumbSchema, menuSchema, recurringEventSchema } from "../lib/schema";

const [SITE, rawPage, rawFaqs] = await Promise.all([getSingleton("siteSettings"), getSingleton("happyHourPage"), getOrderedCollection("happyHourFaqs")]);
const page = resolveSiteTokens(rawPage, SITE);
const faqs = rawFaqs as { question: string; answer: string }[];
const fill = (value: string) => value.replaceAll("{{street}}", SITE.address.street);

const foodItems = (page.food ?? []).map((item: any) => ({
  name: item.name,
  description: item.description,
  image: item.image || undefined,
  imageAlt: item.imageAlt,
}));

const drinkItems = (page.drinks ?? []).map((item: any) => ({
  name: item.name,
  description: item.subtitle ? `${item.subtitle} · ${item.description}` : item.description,
  image: item.image || undefined,
  imageAlt: item.imageAlt,
}));

const schema = [
  faqPageSchema(faqs),
  breadcrumbSchema([
    { name: SITE.breadcrumbs.home, url: SITE.url },
    { name: page.breadcrumbLabel, url: `${SITE.url}/happy-hour` },
  ]),
  recurringEventSchema({
    name: "Happy Hour at Coco Maya",
    description: "Weekday happy hour on the elevated rooftop patio in Little Italy, San Diego: craft cocktails and shareable bites, Monday through Friday, 4:00-6:00 PM.",
    url: `${SITE.url}/happy-hour`,
    daysOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    startTime: "16:00",
    endTime: "18:00",
    placeName: SITE.fullName,
    address: {
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.state,
      postalCode: SITE.address.zip,
      addressCountry: "US",
    },
  }),
  menuSchema(
    [
      { name: "Happy Hour Food", items: foodItems },
      { name: "Happy Hour Cocktails", items: drinkItems },
    ],
    SITE.url
  ),
];
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
  extraSchema={schema}
>
  <Nav />
  <PageHero
    label={page.hero.label}
    title={page.hero.title}
    titleSuffix={page.hero.titleSuffix}
    subtitle={page.hero.subtitle}
    image={page.hero.image}
    imageAlt={page.hero.imageAlt}
    imagePosition={page.hero.imagePosition ?? "object-center"}
    tall={true}
  />

  <TrustBar site={SITE} />

  <section class="pt-24 pb-8 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="relative grid grid-cols-1 sm:grid-cols-3 gap-5">
        {(page.infoCards ?? []).map((card: any) => <InfoCard label={card.label} value={card.value} sub={card.subTemplate ? card.subTemplate.replace("{{street}}", SITE.address.street) : undefined} accent={card.accent} />)}
        <div class="hidden sm:block absolute -z-10 -bottom-5 -right-5 w-full h-full border border-[var(--color-teal)]/30 pointer-events-none"></div>
      </div>
    </div>
  </section>

  <ContainedFeature
    label={page.intro.eyebrow}
    title={page.intro.title}
    body1={page.intro.body1}
    body2={page.intro.body2}
    image={page.intro.image}
    imageAlt={page.intro.imageAlt}
    aspect="1/1"
    ctaLabel={page.intro.reserveLabel}
    ctaHref={SITE.reservations.url}
    secondaryLabel={page.intro.menuLabel}
    secondaryHref="/menu"
    tertiaryLabel={page.relatedPost?.label}
    tertiaryHref={page.relatedPost?.href}
  />

  <FullBleedFeature
    label={page.patioFeature.label}
    title={page.patioFeature.title}
    body1={page.patioFeature.body1}
    body2={page.patioFeature.body2}
    image={page.patioFeature.image}
    imageAlt={page.patioFeature.imageAlt}
    imagePosition={page.patioFeature.imagePosition}
    ctaLabel={page.patioFeature.ctaLabel}
    ctaHref={SITE.reservations.url}
  />

  <MenuShowcase
    eyebrow={page.foodSection.eyebrow}
    title={page.foodSection.title}
    items={foodItems}
  />

  <div class="cm-divider"></div>

  <MenuShowcase
    eyebrow={page.drinksSection.eyebrow}
    title={page.drinksSection.title}
    subtitle={page.drinksSection.subtitle}
    items={drinkItems}
    dark={true}
  />

  <section class="py-24 px-6 bg-[var(--color-cream)]">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {(page.features ?? []).map((item: any) => (
          <ContentCard label={item.label} body={item.body} />
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} label={page.faq.label} title={page.faq.title} />

  <CTASection
    title={page.cta.title}
    subtitle={fill(page.cta.subtitleTemplate)}
    primaryLabel={page.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={page.cta.secondaryLabel}
    secondaryHref={SITE.address.mapsUrl}
    dark={true}
  />
  <Footer />
</BaseLayout>
